{
  "name": "zakamurai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:isolated": "node scripts/dev-isolated.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "deadcode": "knip",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test --project=chromium tests/visual/basic.spec.ts tests/visual/advanced.spec.ts",
    "test:e2e:isolated": "npx playwright test --config=playwright.isolated.config.ts",
    "test:e2e:chromium": "npm run test:e2e",
    "test:visual": "npx playwright test tests/visual/regression.spec.ts",
    "test:visual:chromium": "npx playwright test --project=chromium tests/visual/regression.spec.ts",
    "test:visual:regression": "npm run test:visual:chromium",
    "setup:almostnode": "mkdir -p public/lib/almostnode public/assets && cp -r node_modules/almostnode/dist/* public/lib/almostnode/ && cp node_modules/almostnode/dist/assets/* public/assets/",
    "setup:wasm": "mkdir -p public/wasm public/esbuild && cp node_modules/onnxruntime-web/dist/* public/wasm/ && cp node_modules/esbuild-wasm/esbuild.wasm public/esbuild/esbuild.wasm",
    "setup:playwright": "if [ -z \"$VERCEL\" ]; then playwright install chromium webkit; fi",
    "postinstall": "\"$npm_execpath\" run setup:almostnode && \"$npm_execpath\" run setup:wasm && \"$npm_execpath\" run setup:playwright",
    "predev": "\"$npm_execpath\" run setup:almostnode && \"$npm_execpath\" run setup:wasm",
    "prebuild": "\"$npm_execpath\" run setup:almostnode && \"$npm_execpath\" run setup:wasm",
    "perf": "node scripts/check-performance-budget.mjs",
    "audit": "npm audit --audit-level=critical",
    "verify": "npm run format:check && npm run lint && npm run stylelint && npm run deadcode && npm run test:coverage && npm run build && npm run perf && npm run test:e2e && npm run test:visual:chromium",
    "verify:ai": "bash scripts/verify-ai.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@mlc-ai/web-llm": "0.2.84",
    "almostnode": "0.2.14",
    "esbuild-wasm": "0.28.1",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@next/bundle-analyzer": "16.2.6",
    "@playwright/test": "1.60.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "fast-check": "3.23.2",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "knip": "6.27.0",
    "lint-staged": "15.5.2",
    "promptfoo": "0.121.11",
    "stylelint": "17.11.1",
    "stylelint-config-standard": "40.0.0",
    "vitest": "3.2.7"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": ["biome check --write", "vitest related --run"],
    "src/**/*.module.css": ["stylelint --fix"]
  }
}
