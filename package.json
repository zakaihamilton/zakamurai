{
  "name": "zakamurai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <26",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:isolated": "tsx scripts/dev-isolated.ts",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "deadcode": "knip",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ai-manager": "vitest run src/components/AI/Agent/Manager*.test.ts tests/ai-manager/*.test.ts src/components/App/Panes/Prompt/ManagerTraceInspector.test.tsx src/components/App/Panes/Prompt/useAgentRunner.test.ts src/components/App/Panes/Prompt/Reasoning/Reasoning.test.tsx",
    "test:ai-manager:watch": "vitest src/components/AI/Agent/Manager*.test.ts tests/ai-manager/*.test.ts src/components/App/Panes/Prompt/ManagerTraceInspector.test.tsx src/components/App/Panes/Prompt/useAgentRunner.test.ts src/components/App/Panes/Prompt/Reasoning/Reasoning.test.tsx",
    "test:ai-manager:replay": "vitest run tests/ai-manager/replay.test.ts",
    "test:ai-manager:smoke": "ZAKAMURAI_AI_SMOKE=1 vitest run tests/ai-manager/smoke.test.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "npx playwright test --project=chromium tests/visual/basic.spec.ts tests/visual/advanced.spec.ts",
    "test:e2e:webkit": "npx playwright test --project=webkit tests/visual/basic.spec.ts tests/visual/advanced.spec.ts",
    "test:e2e:isolated": "npx playwright test --config=playwright.isolated.config.ts",
    "test:e2e:isolated:webkit": "npx playwright test --config=playwright.isolated.config.ts --project=webkit",
    "test:e2e:chromium": "npm run test:e2e",
    "test:visual": "npx playwright test --project=chromium tests/visual/regression.spec.ts && npx playwright test tests/visual/accessibility.spec.ts",
    "test:visual:chromium": "npx playwright test --project=chromium tests/visual/regression.spec.ts",
    "test:visual:regression": "npm run test:visual:chromium",
    "setup:almostnode": "tsx scripts/runtime-assets.ts --almostnode",
    "setup:wasm": "tsx scripts/runtime-assets.ts --wasm",
    "setup:playwright": "if [ -z \"$VERCEL\" ]; then playwright install chromium webkit; fi",
    "postinstall": "\"$npm_execpath\" run setup:almostnode && \"$npm_execpath\" run setup:wasm && \"$npm_execpath\" run setup:playwright",
    "predev": "\"$npm_execpath\" run setup:almostnode && \"$npm_execpath\" run setup:wasm",
    "prebuild": "\"$npm_execpath\" run setup:almostnode && \"$npm_execpath\" run setup:wasm",
    "perf": "tsx scripts/check-performance-budget.ts",
    "check:runtime-assets": "tsx scripts/runtime-assets.ts --check",
    "test:performance": "vitest run src/components/App/Views/EditorArea/EditorPerformance.test.ts",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:preview": "tsx scripts/check-preview-surfaces.ts",
    "test:promptfoo": "tsx scripts/run-promptfoo-checks.ts",
    "test:ai-soak": "vitest run src/components/AI/WebLLMAPI.test.ts -t \"sustains a mixed completion and agent lifecycle\"",
    "analyze:ai": "tsx scripts/analyze-ai-support-report.ts",
    "audit": "npm audit --omit=dev --audit-level=critical",
    "verify": "npm run format:check && npm run lint && npm run stylelint && npm run deadcode && npm run check:architecture && npm run typecheck && npm run test:promptfoo && npm run test:coverage && npm run build && npm run perf && npm run check:runtime-assets && npm run test:performance && npm run test:e2e && npm run test:e2e:webkit && npm run test:e2e:isolated && npm run test:e2e:isolated:webkit && npm run check:preview && npm run test:visual && npm run audit",
    "verify:ai": "bash scripts/verify-ai.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@mlc-ai/web-llm": "0.2.84",
    "almostnode": "0.2.14",
    "esbuild-wasm": "0.28.1",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "1.9.4",
    "@next/bundle-analyzer": "16.2.6",
    "@playwright/test": "1.60.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "fast-check": "3.23.2",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "knip": "6.27.0",
    "lint-staged": "15.5.2",
    "promptfoo": "^0.121.19",
    "stylelint": "17.11.1",
    "stylelint-config-standard": "40.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "uuid": "11.1.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": ["biome check --write", "vitest related --run"],
    "src/**/*.module.css": ["stylelint --fix"]
  }
}
