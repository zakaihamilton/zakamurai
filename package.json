{
  "name": "zakamurai",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.22.0 <26",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx scripts/dev-isolated.ts",
    "dev:ide": "next dev --webpack",
    "dev:same-origin": "next dev --webpack",
    "dev:isolated": "tsx scripts/dev-isolated.ts",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome lint . && eslint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "deadcode": "knip",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ai-manager": "vitest run src/components/AI/Agent/Manager*.test.ts tests/ai-manager/*.test.ts src/components/App/Panes/Prompt/ManagerTraceInspector.test.tsx src/components/App/Panes/Prompt/useAgentRunner.test.ts src/components/App/Panes/Prompt/Reasoning/Reasoning.test.tsx",
    "test:ai-manager:watch": "vitest src/components/AI/Agent/Manager*.test.ts tests/ai-manager/*.test.ts src/components/App/Panes/Prompt/ManagerTraceInspector.test.tsx src/components/App/Panes/Prompt/useAgentRunner.test.ts src/components/App/Panes/Prompt/Reasoning/Reasoning.test.tsx",
    "test:ai-manager:replay": "vitest run tests/ai-manager/replay.test.ts",
    "test:ai-manager:smoke": "ZAKAMURAI_AI_SMOKE=1 vitest run tests/ai-manager/smoke.test.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "pnpm exec playwright test --project=chromium tests/visual/basic.spec.ts tests/visual/advanced.spec.ts tests/visual/small-model-preview-smoke.spec.ts",
    "test:e2e:webkit": "pnpm exec playwright test --project=webkit tests/visual/basic.spec.ts tests/visual/advanced.spec.ts",
    "test:e2e:isolated": "pnpm exec playwright test --config=playwright.isolated.config.ts",
    "test:e2e:isolated:webkit": "pnpm exec playwright test --config=playwright.isolated.config.ts --project=webkit",
    "test:e2e:chromium": "pnpm run test:e2e",
    "test:visual": "pnpm run test:visual:chromium && pnpm run test:visual:webkit && pnpm exec playwright test tests/visual/accessibility.spec.ts",
    "test:visual:chromium": "pnpm exec playwright test --project=chromium tests/visual/regression.spec.ts",
    "test:visual:webkit": "pnpm exec playwright test --project=webkit tests/visual/regression.spec.ts",
    "test:visual:regression": "pnpm run test:visual:chromium",
    "test:visual:update": "pnpm exec playwright test tests/visual/regression.spec.ts --update-snapshots=all",
    "setup:almostnode": "tsx scripts/runtime-assets.ts --almostnode",
    "setup:wasm": "tsx scripts/runtime-assets.ts --wasm",
    "setup:playwright": "if [ -z \"$VERCEL\" ]; then playwright install chromium webkit; fi",
    "postinstall": "\"$npm_execpath\" run setup:almostnode && \"$npm_execpath\" run setup:wasm && \"$npm_execpath\" run setup:playwright",
    "predev": "\"$npm_execpath\" run setup:almostnode && \"$npm_execpath\" run setup:wasm",
    "prebuild": "\"$npm_execpath\" run setup:almostnode && \"$npm_execpath\" run setup:wasm",
    "perf": "tsx scripts/check-performance-budget.ts",
    "check:runtime-assets": "tsx scripts/runtime-assets.ts --check",
    "test:performance": "vitest run src/components/App/Views/EditorArea/EditorPerformance.test.ts",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:preview": "tsx scripts/check-preview-surfaces.ts",
    "test:promptfoo": "tsx scripts/run-promptfoo-checks.ts",
    "test:ai-evals": "tsx scripts/run-ai-evals.ts",
    "test:ai-qualification": "ZAKAMURAI_AI_QUALIFICATION=1 vitest run tests/ai-evals/qualification.test.ts",
    "update:ai-eval-baseline": "tsx scripts/update-ai-eval-baseline.ts",
    "test:ai-soak": "vitest run src/components/AI/WebLLMAPI.test.ts -t \"sustains a mixed completion and agent lifecycle\"",
    "analyze:ai": "tsx scripts/analyze-ai-support-report.ts",
    "audit": "pnpm audit --prod --audit-level=high",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run stylelint && pnpm run deadcode && pnpm run check:architecture && pnpm run typecheck && pnpm run test:promptfoo && pnpm run test:ai-evals && pnpm run test:coverage && pnpm run build && pnpm run perf && pnpm run check:runtime-assets && pnpm run test:performance && pnpm run test:e2e && pnpm run test:e2e:webkit && pnpm run test:e2e:isolated && pnpm run test:e2e:isolated:webkit && pnpm run check:preview && pnpm run test:visual && pnpm run audit",
    "verify:ai": "bash scripts/verify-ai.sh",
    "prepare": "husky",
    "health": "tsx scripts/run-health-check.ts",
    "health:duplication": "jscpd src",
    "health:coverage": "c8 --all --reporter=text pnpm test",
    "health:architecture": "depcruise --output-type json --config -- src",
    "health:licenses": "license-checker --json",
    "health:documentation": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#test-results\" \"#.next\" \"#coverage\" \"#.repnix\"",
    "health:a11y": "pnpm exec playwright test --project=chromium tests/visual/accessibility.spec.ts",
    "health:visual": "pnpm exec playwright test --project=chromium tests/visual/regression.spec.ts",
    "health:interactions": "vitest run src/components/App/Panes/Prompt/Reasoning/Reasoning.test.tsx"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@mlc-ai/web-llm": "0.2.84",
    "almostnode": "0.2.14",
    "esbuild-wasm": "0.28.1",
    "next": "16.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "triactor": "^0.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "1.9.4",
    "@next/bundle-analyzer": "16.4.1",
    "@playwright/test": "1.60.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "c8": "^12.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fast-check": "3.23.2",
    "husky": "9.1.7",
    "jscpd": "^5.0.14",
    "jsdom": "^26.1.0",
    "knip": "6.27.0",
    "license-checker": "^25.0.1",
    "lint-staged": "15.5.2",
    "markdownlint-cli2": "^0.23.2",
    "promptfoo": "^0.121.19",
    "repnix": "^1.1.0",
    "stylelint": "17.11.1",
    "stylelint-config-standard": "40.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "ink": "7.1.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "uuid": "11.1.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": ["biome check --write", "vitest related --run"],
    "src/**/*.module.css": ["stylelint --fix"]
  },
  "packageManager": "pnpm@10.33.0"}
