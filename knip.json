{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.{js,jsx,ts,tsx}"],
  "ignore": [
    "src/components/AI/index.js",
    "src/components/AI/Agent/index.js",
    "src/utils/empty.js"
  ],
  "ignoreDependencies": ["almostnode", "fast-check", "promptfoo", "esbuild-wasm"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "off"
  }
}
